{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play Voxel World",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${command:cmake.launchTargetDirectory};${env:PATH}"
